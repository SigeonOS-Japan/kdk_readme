\pard\pardeftab720\sa120\partightenfactor0

\f0 \cf2 \
\pard\tx720\pardeftab720\partightenfactor0

\f3\i\b \cf2 Step 6: Rebuild the Kernel Collections and Bless the Changes\
\pard\pardeftab720\sa120\partightenfactor0

\f0\i0\b0 \cf2 Run 
\f4 \cf3 kmutil
\f0 \cf2  in Terminal to rebuild the kernel collections for the variants you added to your mounted disk. Run 
\f4 \cf3 bless
\f0 \cf2  to authorize booting from your modified kernels.\
\pard\tx360\tx576\pardeftab720\li576\fi-576\sa120\partightenfactor0

\f4 \cf3 sudo kmutil install --volume-root /Users/jappleseed/livemount --update-all\
sudo bless --mount /Users/jappleseed/livemount --bootefi --create-snapshot\
\pard\pardeftab720\sa120\partightenfactor0

\f0 \cf2 \
\pard\tx720\pardeftab720\partightenfactor0

\f3\i\b \cf2 Step 7: Set the boot-args\

\pard\pardeftab720\sa120\partightenfactor0

\f4 \cf3 mkdir /Users/jappleseed/livemount \
sudo mount -o nobrowse -t apfs  /dev/disk4s5 /Users/jappleseed/livemount\
\pard\pardeftab720\sa120\partightenfactor0

\f0 \cf2 \
\pard\tx720\pardeftab720\partightenfactor0

\f3\i\b \cf2 Step 5: Add the Variant Files to the Live Mount\
\pard\pardeftab720\sa120\partightenfactor0

\f0\i0\b0 \cf2 Add the kernel variant files to the newly mounted disk. The easiest way to copy the files is to copy the entire 
\f4 \cf3 /System
\f0 \cf2  directory of the KDK into the 
\f4 \cf3 /System
\f0 \cf2  directory of your mounted disk, as shown in the following example:\
